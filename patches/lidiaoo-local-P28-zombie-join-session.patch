--- a/AirportMtkWlan/WCL/WCL.cpp	2026-11-09 16:22:50
+++ b/AirportMtkWlan/WCL/WCL.cpp	2026-11-09 16:20:31
@@ -1178,6 +1178,17 @@
             ieee80211_new_state(ic, IEEE80211_S_INIT, -1);
         }
     } else {
+        /*
+         * PATCH [local-p28]: end the join session on success too.  Leaving
+         * ic_wcl_join_requested set after a completed join let the net80211
+         * state machine re-match the stale desired ESS out of the node tree
+         * after any power cycle or beacon loss -- an association airportd
+         * never asked for and never learned about ("zombie"): its UI showed
+         * disconnected, its live scans got rejected busy and every join by
+         * name failed with "Could not find network".  macOS owns joins; a
+         * reconnect after a drop must come from airportd as a fresh request.
+         */
+        fHalService->get80211Controller()->ic_wcl_join_requested = false;
         /* PATCH [local-p18]: the key is live again, so a later zero-PSK
          * report is a genuine fault and must not be suppressed. */
         fHalService->get80211Controller()->ic_wcl_psk_wiped = false;
--- a/mtk80211/openbsd/net80211/ieee80211_node.c	2026-11-09 11:18:20
+++ b/mtk80211/openbsd/net80211/ieee80211_node.c	2026-11-09 16:22:01
@@ -1545,6 +1545,26 @@
         return;
     }
     
+    /*
+     * PATCH [local-p28]: macOS owns every join.  With no live WCL join
+     * request, end_scan must not pick a BSS on its own -- neither for the
+     * initial association (the empty-tree case above already idles, but a
+     * 500-entry cache tree defeated that check) nor for a background roam.
+     * A stale desired ESS from an aborted join request used to auto-auth
+     * out of the node tree and form a zombie association airportd never
+     * learned about.  Just drop the bgscan marker; airportd reconnects
+     * with a fresh join request when it sees the link go down.
+     */
+    if (!ic->ic_wcl_join_requested) {
+        if (bgscan)
+            ic->ic_flags &= ~IEEE80211_F_BGSCAN;
+        else if (ic->ic_state != IEEE80211_S_RUN) {
+            ieee80211_reset_scan(ifp);
+            ic->ic_wcl_scan_idle = true;
+        }
+        return;
+    }
+
     /* Possibly switch which ssid we are associated with */
     if (!bgscan && ic->ic_opmode == IEEE80211_M_STA)
         ieee80211_switch_ess(ic);
