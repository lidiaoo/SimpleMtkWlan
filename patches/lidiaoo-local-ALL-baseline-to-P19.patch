+			    now_ns - first_run_ns > 60000000000ULL) {
+				first_run_ns = now_ns;
+				run_entries = 0;
+			}
+			run_entries++;
+			last_run_ns = now_ns;
+			if (run_entries >= 5) {
+				MWX_DEV_LOG(sc, "reached RUN %d times in %llu ms, "
+				    "4-way never settles, resetting to S_INIT\n",
+				    run_entries,
+				    (unsigned long long)((now_ns - first_run_ns) /
+				    1000000ULL));
