+				first_run_ns = 0;
+				last_run_ns = 0;
+				prev_state = -1;
+				ieee80211_new_state(ic, IEEE80211_S_INIT, -1);
+			}
+		}
+		prev_state = ic->ic_state;
+		(void)last_run_ns;
